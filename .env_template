# Copy to .env and fill in; registered_businesses.py loads it automatically.
# Path to the GCP service account JSON key file.
GCP_SERVICE_ACCOUNT_KEY=
# GCP project that owns the bucket.
GCP_PROJECT_ID=sf-pet-care
# Base bucket name; "-dev" or "-prod" is appended depending on dev_mode.
GCP_BUCKET_NAME=sf-pet-care-bucket
# Optional Socrata app token for higher rate limits.
SODA_APP_TOKEN=
