# U.S. Census API key used to collect ACS 2024 5-Year data.
CENSUS_API_KEY=your_census_api_key

# Google Cloud project used by this group project.
GCP_PROJECT_ID=sf-pet-care

# Path to the Google Cloud service account JSON key file.
GCP_SERVICE_ACCOUNT_KEY=path_to_service_account_key.json

# Base bucket name.
# The code adds "-dev" or "-prod" depending on dev_mode.
GCP_BUCKET_NAME=sf-pet-care-bucket