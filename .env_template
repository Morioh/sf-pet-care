# Copy this file to .env and fill in your own values:
#     cp .env_template .env
#
# .env is listed in .gitignore and must never be committed.
# The service-account key itself is never committed either - only the PATH to it
# goes in .env, and the key file lives outside the repo.

# GCP project that owns the buckets.
GCP_PROJECT_ID=sf-pet-care

# Bucket BASE name. The scripts append "-dev" or "-prod" themselves, per the
# work contract, so do NOT put the suffix here.
GCP_BUCKET_NAME=sf-pet-care-bucket

# Absolute path to your service-account JSON key.
# Create one with:
#   gcloud iam service-accounts keys create ~/.ssh/sf-pet-care-key.json \
#     --iam-account=sf-pet-service-account@sf-pet-care.iam.gserviceaccount.com \
#     --project=sf-pet-care
#   chmod 600 ~/.ssh/sf-pet-care-key.json
GCP_SERVICE_ACCOUNT_KEY=/absolute/path/to/your-sf-pet-care-key.json

# Optional - only used by the business collector to raise Socrata rate limits.
# Free token from https://data.sf.gov/profile/edit/developer_settings
SODA_APP_TOKEN=

# Required by the census collector.
# Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
