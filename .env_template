# U.S. Census API key used to collect ACS 2024 5-Year data.
# Replace the placeholder with your own Census API key in the local .env file.
CENSUS_API_KEY=your_census_api_key

# Google Cloud project used by this group project.
GCP_PROJECT_ID=sf-pet-care

# Development bucket used to store the collected ACS data.
GCP_DEV_BUCKET=sf-pet-care-bucket-dev

# Production bucket reserved for finalized project data.
GCP_PROD_BUCKET=sf-pet-care-bucket-prod
