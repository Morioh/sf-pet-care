# Copy to .env and fill in; registered_businesses.py loads it automatically.
# GCP project that owns the bucket (required when GCS_BUCKET is set).
GCP_PROJECT_ID=sf-pet-care
# Bucket for collected data. Leave empty to save to data/raw/ locally instead.
GCS_BUCKET=sf-pet-care-bucket-dev
# Folder inside the bucket. Leave empty to write to the bucket root.
GCS_PREFIX=registered_businesses
# Registered Business Locations endpoint (required).
SODA_DATASET_URL=https://data.sf.gov/resource/g8m3-pdis.json
# Optional Socrata app token for higher rate limits.
SODA_APP_TOKEN=
